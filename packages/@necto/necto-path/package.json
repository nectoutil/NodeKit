{
  "name": "@necto/path",
  "version": "0.1.0",
  "description": "Necto's cross-platform, drop in replacement to Node's path utilities",
  "scripts": {
    "build": "vp pack",
    "test": "vitest",
    "test:coverage": "vitest run --coverage --passWithNoTests"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "type": "module",
  "types": "./dist/index.d.mts",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "sideEffects": false,
  "exports": {
    ".": {
      "development": {
        "types": "./dist/index.d.mts",
        "import": "./dist/dev/index.mjs",
        "require": "./dist/dev/index.cjs"
      },
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "author": "Corinvo OSS Team",
  "license": "MIT",
  "devDependencies": {
    "@vitest/coverage-istanbul": "^4.1.10",
    "fast-check": "^4.8.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/nectoutil/NodeKit",
    "directory": "packages/@necto/necto-path"
  }
}
